# --- Build Artifacts ---
# The /target directory contains all compiled code and dependencies. 
# It can get very large, so it should never be committed.
/target/
/dist/
/phonolite-server
/phonolite-server.exe
phonolite-server-*.tar.gz
phonolite-server-*.tar.gz.sha256
.phonolite-package-*/

# Python caches from the packaging helper
__pycache__/
*.pyc
*.pyo

# Runtime files when a server executable is placed in the repository root
/config.yaml
/library.redb
/user_data.redb
/stats.redb
/quic_cert.pem
/quic_key.pem
/metadata/
/logs/
/stream_cache/

# --- Assets & Backup Files ---
# Ignore backup files generated by editors or OS
*.bak
*.swp
*~
.DS_Store
Thumbs.db

# --- Environment & Secrets ---
# If you use crates like `dotenv`, ignore your local environment files
.env
.env*.local
*.tls-rotation.json
*.rotation.pem

# --- IDE Specifics ---
# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# IntelliJ / PyCharm / RustRover
.idea/
*.iml

# --- Cargo Lock File ---
# For executable (bin) projects, you SHOULD commit Cargo.lock.
# For library projects, it is often ignored (uncomment the line below if making a lib).
# Cargo.lock
