#!/bin/sh
set -e

case "$1" in
    remove|deconfigure)
        if [ -d /run/systemd/system ]; then
            deb-systemd-invoke stop phonolite-server.service || true
        fi
        if [ "$1" = remove ]; then
            deb-systemd-helper disable phonolite-server.service >/dev/null || true
        fi
        ;;
esac

exit 0
