[Unit]
Description=Phonolite Server
After=network.target

[Service]
Type=simple
User=phonolite
Group=phonolite
StateDirectory=phonolite
StateDirectoryMode=0700
WorkingDirectory=/var/lib/phonolite
Environment=PHONOLITE_CONFIG=/var/lib/phonolite/config.yaml
ExecStart=/usr/local/bin/phonolite-server
Restart=on-failure
RestartSec=5
# The server drains work for 20s, then bounds runtime cleanup to another 5s.
TimeoutStopSec=35s
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
